    "menus": {
      "editor/title": [
        {
          "command": "sdd.gherkin.openVisualEditor",
          "when": "resourceExtname == .feature && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.gherkin.openTextEditor",
          "when": "activeCustomEditorId == sdd.gherkin.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.openapi.openVisualEditor",
          "when": "sdd.openapi.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.openapi.openTextEditor",
          "when": "activeCustomEditorId == sdd.openapi.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.asyncapi.openVisualEditor",
          "when": "sdd.asyncapi.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.asyncapi.openTextEditor",
          "when": "activeCustomEditorId == sdd.asyncapi.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.proto.openVisualEditor",
          "when": "resourceExtname == .proto && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.proto.openTextEditor",
          "when": "activeCustomEditorId == sdd.proto.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.opencli.openVisualEditor",
          "when": "sdd.opencli.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.opencli.openTextEditor",
          "when": "activeCustomEditorId == sdd.opencli.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.spec.openVisualEditor",
          "when": "sdd.spec.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.spec.openTextEditor",
          "when": "activeCustomEditorId == sdd.spec.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.otm.openVisualEditor",
          "when": "sdd.otm.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.otm.openTextEditor",
          "when": "activeCustomEditorId == sdd.otm.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.backstage.openVisualEditor",
          "when": "sdd.backstage.activeEditorIsCatalog && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.backstage.openTextEditor",
          "when": "activeCustomEditorId == sdd.backstage.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.backstage.openConsolidatedCatalog",
          "when": "activeCustomEditorId == sdd.backstage.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.openslo.openVisualEditor",
          "when": "sdd.openslo.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.openslo.openTextEditor",
          "when": "activeCustomEditorId == sdd.openslo.editor",
          "group": "navigation"
        },
        {
          "command": "sdd.adr.openVisualEditor",
          "when": "sdd.adr.activeEditorIsSpec && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "sdd.adr.openTextEditor",
          "when": "activeCustomEditorId == sdd.adr.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "sdd.gherkin.newFeature",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.openapi.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.gherkin.openFeaturesOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.openapi.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.asyncapi.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.asyncapi.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.proto.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.proto.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.gherkin.openTextEditor",
          "when": "resourceExtname == .feature",
          "group": "navigation@9"
        },
        {
          "command": "sdd.opencli.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.opencli.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.spec.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.spec.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.otm.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.otm.openThreatModelsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.backstage.newCatalogFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.backstage.openCatalogOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.backstage.openConsolidatedCatalog",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.openslo.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.openslo.openSpecsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.adr.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.adr.openDecisionsOverview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "sdd.addUpdateInstructions",
          "group": "7_modification@9",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(ya?ml|json|feature|proto|md|markdown)$/"
        }
      ],
      "commandPalette": [
        {
          "command": "sdd.studio.openOverview",
          "when": "false"
        },
        {
          "command": "sdd.gherkin.openVisualEditor",
          "when": "resourceExtname == .feature"
        },
        {
          "command": "sdd.gherkin.openTextEditor",
          "when": "resourceExtname == .feature"
        },
        {
          "command": "sdd.openapi.openVisualEditor",
          "when": "sdd.openapi.activeEditorIsSpec"
        },
        {
          "command": "sdd.openapi.openTextEditor",
          "when": "activeCustomEditorId == sdd.openapi.editor"
        },
        {
          "command": "sdd.asyncapi.openVisualEditor",
          "when": "sdd.asyncapi.activeEditorIsSpec"
        },
        {
          "command": "sdd.asyncapi.openTextEditor",
          "when": "activeCustomEditorId == sdd.asyncapi.editor"
        },
        {
          "command": "sdd.proto.openVisualEditor",
          "when": "resourceExtname == .proto"
        },
        {
          "command": "sdd.proto.openTextEditor",
          "when": "activeCustomEditorId == sdd.proto.editor"
        },
        {
          "command": "sdd.opencli.openVisualEditor",
          "when": "sdd.opencli.activeEditorIsSpec"
        },
        {
          "command": "sdd.opencli.openTextEditor",
          "when": "activeCustomEditorId == sdd.opencli.editor"
        },
        {
          "command": "sdd.spec.openVisualEditor",
          "when": "sdd.spec.activeEditorIsSpec"
        },
        {
          "command": "sdd.spec.openTextEditor",
          "when": "activeCustomEditorId == sdd.spec.editor"
        },
        {
          "command": "sdd.otm.openVisualEditor",
          "when": "sdd.otm.activeEditorIsSpec"
        },
        {
          "command": "sdd.otm.openTextEditor",
          "when": "activeCustomEditorId == sdd.otm.editor"
        },
        {
          "command": "sdd.backstage.openVisualEditor",
          "when": "sdd.backstage.activeEditorIsCatalog"
        },
        {
          "command": "sdd.backstage.openTextEditor",
          "when": "activeCustomEditorId == sdd.backstage.editor"
        },
        {
          "command": "sdd.openslo.openVisualEditor",
          "when": "sdd.openslo.activeEditorIsSpec"
        },
        {
          "command": "sdd.openslo.openTextEditor",
          "when": "activeCustomEditorId == sdd.openslo.editor"
        },
        {
          "command": "sdd.adr.openVisualEditor",
          "when": "sdd.adr.activeEditorIsSpec"
        },
        {
          "command": "sdd.adr.openTextEditor",
          "when": "activeCustomEditorId == sdd.adr.editor"
        }
      ],
      "view/title": [
        {
          "submenu": "sdd.explorerMenu",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@9"
        },
        {
          "command": "sdd.studio.open",
          "when": "view == sdd.studio.home",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sdd.studio.openOverview",
          "when": "view == sdd.studio.documents && viewItem == sddKind",
          "group": "inline"
        }
      ],
      "sdd.explorerMenu": [
        {
          "command": "sdd.studio.open",
          "group": "0_home@1"
        },
        {
          "command": "sdd.prompts.open",
          "group": "1_workspace@1"
        },
        {
          "command": "sdd.backstage.openConsolidatedCatalog",
          "group": "1_workspace@2"
        },
        {
          "command": "sdd.backstage.openCatalogOverview",
          "group": "2_pages@1"
        },
        {
          "command": "sdd.spec.openSpecsOverview",
          "group": "2_pages@2"
        },
        {
          "command": "sdd.gherkin.openFeaturesOverview",
          "group": "2_pages@3"
        },
        {
          "command": "sdd.openapi.openSpecsOverview",
          "group": "2_pages@4"
        },
        {
          "command": "sdd.asyncapi.openSpecsOverview",
          "group": "2_pages@5"
        },
        {
          "command": "sdd.proto.openSpecsOverview",
          "group": "2_pages@6"
        },
        {
          "command": "sdd.opencli.openSpecsOverview",
          "group": "2_pages@7"
        },
        {
          "command": "sdd.otm.openThreatModelsOverview",
          "group": "2_pages@8"
        },
        {
          "command": "sdd.openslo.openSpecsOverview",
          "group": "2_pages@9"
        },
        {
          "command": "sdd.adr.openDecisionsOverview",
          "group": "2_pages@10"
        },
        {
          "command": "sdd.addUpdateInstructionsToWorkspace",
          "group": "3_instructions@1"
        }
      ]
    },
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "feature"
        ],
        "extensions": [
          ".feature"
        ]
      }
    ],
    "configuration": {
      "title": "SDD Studio",
      "properties": {
        "sdd.gherkin.stepSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Suggest step texts already used in other .feature files of the workspace."
        },
        "sdd.gherkin.featuresFolder": {
          "type": "string",
          "default": "specs/features",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Features overview** creates new features by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.openapi.specsFolder": {
          "type": "string",
          "default": "specs/apis",
          "markdownDescription": "Folder (relative to each workspace folder) where the **API Specs overview** creates new OpenAPI specifications by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.asyncapi.specsFolder": {
          "type": "string",
          "default": "specs/apis",
          "markdownDescription": "Folder (relative to each workspace folder) where the **AsyncAPI Specs overview** creates new AsyncAPI specifications by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.proto.specsFolder": {
          "type": "string",
          "default": "specs/protos",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Proto Files overview** creates new `.proto` files by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.proto.importPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra import roots (relative to the workspace folder), like `protoc -I`, used by the proto form editor to find imported files. Folders from the edited file up to the workspace root are always searched."
        },
        "sdd.opencli.specsFolder": {
          "type": "string",
          "default": "specs/clis",
          "markdownDescription": "Folder (relative to each workspace folder) where the **CLI Specs overview** creates new OpenCLI descriptions by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.spec.specsFolder": {
          "type": "string",
          "default": "specs/generics",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Specs overview** creates new markdown specs (`.spec.md`) by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.spec.keywordIcons": {
          "type": "object",
          "markdownDescription": "Icon written in front of each RFC 2119 key word in the `####` headings of markdown specs, e.g. `#### ✅ MUST`. An empty string writes the key word alone. Specs are read whatever icon they were written with, and get these icons at their next change in the form editor.",
          "properties": {
            "MUST": { "type": "string", "default": "✅" },
            "MUST NOT": { "type": "string", "default": "⛔" },
            "SHOULD": { "type": "string", "default": "👍" },
            "SHOULD NOT": { "type": "string", "default": "👎" },
            "MAY": { "type": "string", "default": "🆗" },
            "No key word": { "type": "string", "default": "❔", "description": "Heading of the requirements written without a key word in capitals." }
          },
          "additionalProperties": false,
          "default": {
            "MUST": "✅",
            "MUST NOT": "⛔",
            "SHOULD": "👍",
            "SHOULD NOT": "👎",
            "MAY": "🆗",
            "No key word": "❔"
          }
        },
        "sdd.otm.threatModelsFolder": {
          "type": "string",
          "default": "specs/threat-models",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Threat Models overview** creates new Open Threat Model files (`.otm.yaml`, `.otm.json`) by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.backstage.catalogFolder": {
          "type": "string",
          "default": "specs/catalogs",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Software Catalog overview** creates new Backstage catalog files (`.catalog-info.yaml`) by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.backstage.diagramsFolder": {
          "type": "string",
          "default": "docs/diagrams",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Diagram** page of the software catalog saves exported Mermaid diagrams, as markdown files holding a ```mermaid block."
        },
        "sdd.openslo.specsFolder": {
          "type": "string",
          "default": "specs/slos",
          "markdownDescription": "Folder (relative to each workspace folder) where the **OpenSLO Files overview** creates new OpenSLO files (`.openslo.yaml`) by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.adr.decisionsFolder": {
          "type": "string",
          "default": "docs/decisions",
          "markdownDescription": "Folder (relative to each workspace folder) where the **Decisions overview** creates new Architecture Decision Records (numbered markdown files) by default. All its subfolders are offered as destinations, even empty ones."
        },
        "sdd.instructions.addToNewFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Write **update instructions** for people and AI assistants at the top of new spec files: the format, a link to its JSON schema and the conventions SDD Studio relies on. JSON files only get the schema link (JSON has no comments)."
        },
        "sdd.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the SDD Studio **MCP server** of this window on `127.0.0.1`, so AI assistants (Claude Code, GitHub Copilot) can read the software catalog and create, link and check spec files. Requests need the token SDD Studio generates."
        },
        "sdd.mcp.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "Port of the MCP server. `0` picks a free port for each window, published to terminals as `SDD_STUDIO_MCP_URL` (used by **SDD Studio: Configure Claude Code**). Set a port to configure clients by hand; when it is taken, the window falls back to a free port."
        },
        "sdd.api.writeWithoutReview": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When AI assistants and other extensions create or link spec files, write and save the files and the catalog changes directly. When off, new files and catalog changes are left open, **unsaved**, for you to review and save."
        }
      }
    },
    "submenus": [
      {
        "id": "sdd.explorerMenu",
        "label": "SDD Studio",
        "icon": "$(library)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdd-studio",
          "title": "SDD Studio",
          "icon": "media/sdd-studio.svg"
        }
      ]
    },
    "views": {
      "sdd-studio": [
        {
          "id": "sdd.studio.home",
          "name": "Home",
          "contextualTitle": "SDD Studio",
          "icon": "media/sdd-studio.svg",
          "initialSize": 1
        },
        {
          "id": "sdd.studio.documents",
          "name": "Documents",
          "contextualTitle": "SDD Studio",
          "icon": "media/sdd-studio.svg",
          "initialSize": 8
        },
        {
          "id": "sdd.studio.misc",
          "name": "Miscellaneous",
          "contextualTitle": "SDD Studio",
          "icon": "media/sdd-studio.svg",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sdd.studio.home",
        "contents": "[Open SDD Studio](command:sdd.studio.open)\nThe catalog, every kind of spec and the pages for AI assistants, in one page."
      },
      {
        "view": "sdd.studio.documents",
        "contents": "Open a folder or workspace to work on its specs.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "sdd-studio",
        "label": "SDD Studio"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --skip-license --allow-missing-repository",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.101.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
