{
  "name": "sdd-studio",
  "displayName": "SDD Studio",
  "description": "Specification-Driven Development: edit standard spec files (Gherkin, OpenAPI, AsyncAPI, gRPC/Protobuf, OpenCLI, markdown specs with RFC 2119 requirements, Open Threat Model, OpenSLO, Architecture Decision Records) and a Backstage software catalog linking them together through visual forms, while keeping plain files on disk, with an API and MCP server for AI assistants and other extensions.",
  "version": "0.1.0",
  "publisher": "sdd",
  "repository": {
    "type": "git",
    "url": "https://github.com/stfbln/sdd-studio.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "sdd",
    "specification",
    "gherkin",
    "cucumber",
    "bdd",
    "openapi",
    "swagger",
    "api",
    "asyncapi",
    "events",
    "grpc",
    "protobuf",
    "proto",
    "opencli",
    "cli",
    "markdown",
    "requirements",
    "rfc2119",
    "threat-model",
    "otm",
    "security",
    "backstage",
    "catalog-info",
    "software-catalog",
    "openslo",
    "slo",
    "sli",
    "error-budget",
    "observability",
    "adr",
    "architecture-decision-record",
    "madr",
    "mcp",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.feature",
    "onWebviewPanel:sdd.gherkin.featuresOverview",
    "onLanguage:yaml",
    "onLanguage:json",
    "onWebviewPanel:sdd.openapi.specsOverview",
    "onWebviewPanel:sdd.asyncapi.specsOverview",
    "workspaceContains:**/*.proto",
    "onWebviewPanel:sdd.proto.specsOverview",
    "onWebviewPanel:sdd.opencli.specsOverview",
    "onWebviewPanel:sdd.spec.specsOverview",
    "onLanguage:markdown",
    "onWebviewPanel:sdd.otm.threatModelsOverview",
    "onWebviewPanel:sdd.backstage.catalogOverview",
    "onWebviewPanel:sdd.backstage.consolidatedCatalog",
    "onWebviewPanel:sdd.openslo.specsOverview",
    "onStartupFinished",
    "onWebviewPanel:sdd.prompts.panel",
    "onWebviewPanel:sdd.adr.decisionsOverview",
    "onWebviewPanel:sdd.studio.home"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "sdd.gherkin.editor",
        "displayName": "SDD Gherkin Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.feature"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.openapi.editor",
        "displayName": "SDD OpenAPI Form Editor",
        "selector": [
          {
            "filenamePattern": "*.openapi.yaml"
          },
          {
            "filenamePattern": "*.openapi.yml"
          },
          {
            "filenamePattern": "*.openapi.json"
          },
          {
            "filenamePattern": "openapi.yaml"
          },
          {
            "filenamePattern": "openapi.yml"
          },
          {
            "filenamePattern": "openapi.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.asyncapi.editor",
        "displayName": "SDD AsyncAPI Form Editor",
        "selector": [
          {
            "filenamePattern": "*.asyncapi.yaml"
          },
          {
            "filenamePattern": "*.asyncapi.yml"
          },
          {
            "filenamePattern": "*.asyncapi.json"
          },
          {
            "filenamePattern": "asyncapi.yaml"
          },
          {
            "filenamePattern": "asyncapi.yml"
          },
          {
            "filenamePattern": "asyncapi.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.proto.editor",
        "displayName": "SDD Protobuf Form Editor",
        "selector": [
          {
            "filenamePattern": "*.proto"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.opencli.editor",
        "displayName": "SDD OpenCLI Form Editor",
        "selector": [
          {
            "filenamePattern": "*.opencli.json"
          },
          {
            "filenamePattern": "*.opencli.yaml"
          },
          {
            "filenamePattern": "*.opencli.yml"
          },
          {
            "filenamePattern": "opencli.json"
          },
          {
            "filenamePattern": "opencli.yaml"
          },
          {
            "filenamePattern": "opencli.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.spec.editor",
        "displayName": "SDD Spec Form Editor",
        "selector": [
          {
            "filenamePattern": "*.spec.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.otm.editor",
        "displayName": "SDD Threat Model Form Editor",
        "selector": [
          {
            "filenamePattern": "*.otm.yaml"
          },
          {
            "filenamePattern": "*.otm.yml"
          },
          {
            "filenamePattern": "*.otm.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.backstage.editor",
        "displayName": "SDD Software Catalog Form Editor",
        "selector": [
          {
            "filenamePattern": "catalog-info.yaml"
          },
          {
            "filenamePattern": "catalog-info.yml"
          },
          {
            "filenamePattern": "*.catalog-info.yaml"
          },
          {
            "filenamePattern": "*.catalog-info.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.openslo.editor",
        "displayName": "SDD OpenSLO Form Editor",
        "selector": [
          {
            "filenamePattern": "*.openslo.yaml"
          },
          {
            "filenamePattern": "*.openslo.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sdd.adr.editor",
        "displayName": "SDD ADR Form Editor",
        "selector": [
          {
            "filenamePattern": "[0-9][0-9][0-9][0-9]-*.md"
          }
        ],
        "priority": "default"
      }
    ],
